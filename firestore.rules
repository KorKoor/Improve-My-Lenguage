rules_version = '2';

// Todo el acceso a datos pasa por el servidor (Firebase Admin SDK, que ignora
// estas reglas). El navegador nunca lee ni escribe Firestore directamente:
// así la validación, la autorización y el rate limiting viven en un solo sitio.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
