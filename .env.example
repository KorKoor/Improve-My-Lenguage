# ─────────────────────────────────────────────────────────────────────────────
# Improve My Languages — variables de entorno
# Copia este archivo a .env.local (desarrollo) y configura las mismas en Vercel.
# NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio (para OAuth, sitemap, Open Graph). En producción: tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon"/"publishable" key: es pública por diseño (RLS bloquea todas las tablas).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# SOLO SERVIDOR. Contiene la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Opcional, SOLO SERVIDOR: permite borrar la identidad en Supabase Auth al eliminar la cuenta.
# Si no se define, se intenta vía SQL (los datos de la app se borran siempre).
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase Web / Push Notifications ───────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (SOLO SERVIDOR; contiene la clave privada del service account)
# Debe ser un JSON válido de una sola línea, con \n escapados.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"improve-my-lenguages","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ── IA (opcional: sin clave, la app funciona y sólo se desactiva el tutor) ───
# gemini | openai-compatible | none
AI_PROVIDER=gemini
# Google AI Studio → Get API key (capa gratuita). SOLO SERVIDOR.
GEMINI_API_KEY=
# Para AI_PROVIDER=openai-compatible (Groq, OpenRouter, Ollama…):
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Modelos (opcional; si se omiten se usan los de src/lib/ai/provider.ts)
AI_MODEL_FAST=
AI_MODEL_SMART=
# Límite de llamadas de IA por usuario y día (protege la cuota gratuita)
AI_DAILY_LIMIT_PER_USER=60
