# ─────────────────────────────────────────────────────────────────────────────
# Improve My Languages — variables de entorno
# Copia este archivo a .env.local (desarrollo) y configura las mismas en Vercel.
# NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio (sitemap, Open Graph, enlaces). En producción: tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase Web (públicas por diseño) ──────────────────────────────────────
# Firebase console → Configuración del proyecto → General → Tus apps → Web.
# (o: firebase apps:sdkconfig WEB <APP_ID>)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=improve-my-lenguages.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=improve-my-lenguages
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=improve-my-lenguages.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging → Certificados push web (sólo para notificaciones)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Firebase Admin (SOLO SERVIDOR) ──────────────────────────────────────────
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
# Pega el JSON completo en UNA sola línea. Da acceso total al proyecto: jamás
# lo expongas al navegador ni lo subas al repositorio.
FIREBASE_SERVICE_ACCOUNT=
# Alternativa en local: ruta al archivo JSON (fuera del repo) en lugar de la variable anterior.
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\fuera\del\repo\service-account.json

# Secreto para los cron jobs de Vercel (recordatorios diarios). Vercel lo envía
# como "Authorization: Bearer <CRON_SECRET>". Genera uno largo y aleatorio.
CRON_SECRET=

# ── IA (opcional: sin clave, la app funciona y sólo se desactiva el tutor) ───
# gemini | openai-compatible | none
AI_PROVIDER=gemini
# Google AI Studio → Get API key (capa gratuita). SOLO SERVIDOR.
GEMINI_API_KEY=
# Para AI_PROVIDER=openai-compatible (Groq, OpenRouter, Ollama…):
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Modelos (opcional; si se omiten se usan los de src/lib/ai/provider.ts)
AI_MODEL_FAST=
AI_MODEL_SMART=
# Límite de llamadas de IA por usuario y día (protege la cuota gratuita)
AI_DAILY_LIMIT_PER_USER=60

# Correos (separados por comas) que pueden revisar los reportes de contenido en /app/admin.
ADMIN_EMAILS=
